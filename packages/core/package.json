{
  "name": "@noteriv/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-neutral Noteriv logic shared by web and desktop: parsing, markdown helpers, data models. No React, Next, Tauri or app code.",
