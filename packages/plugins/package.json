{
  "name": "@noteriv/plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Noteriv core plugins (trusted tier of Plugin API v1). Each folder under src/ is one plugin, loaded by the apps with a dynamic import() so a disabled plugin's code is not in the initial bundle.",
  "license": "MIT",
  "exports": {
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "dependencies": {
    "@noteriv/core": "*",
    "@noteriv/plugin-api": "*"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
