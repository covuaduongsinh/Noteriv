{
  "name": "@noteriv/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React + CodeMirror UI shared by web and desktop: markdown live-preview renderers, editors, panels. Talks to the vault only through a VaultAdapter; no webApi, no electronAPI, no app code.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./markdown/*": "./src/markdown/*.ts",
    "./editor": "./src/editor/index.ts",
    "./editor/*": "./src/editor/*.ts",
    "./panels": "./src/panels/index.ts",
    "./panels/*": "./src/panels/*.ts",
    "./styles/*": "./styles/*",
    "./plugins": "./src/plugins/index.ts",
    "./plugins/*": "./src/plugins/*.ts",
    "./plugins/sandbox": "./src/plugins/sandbox/index.ts",
    "./public/*": "./public/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "dependencies": {
    "@noteriv/core": "*",
    "katex": "^0.19.0",
    "@noteriv/plugin-api": "*",
    "dompurify": "^3.4.13"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vim": "^6.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
