# Used by the Next.js dev-time rewrites() proxy in next.config.ts to reach the
# Fastify backend. In production this should point at the backend's internal
# service address (e.g. Dokploy's internal service hostname), not a public URL.
NOTERIV_API_ORIGIN=http://127.0.0.1:4001

# Public URL the browser connects to for the realtime collab WebSocket.
# collab.ts appends /collab/notes/:noteId itself — do not include /collab here.
NEXT_PUBLIC_COLLAB_WS_URL=wss://noteriv.dsc.edu.vn
