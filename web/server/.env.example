DATABASE_URL=postgresql://user:password@127.0.0.1:5432/noteriv
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
PORT=4001
NODE_ENV=production
CORS_ORIGIN=https://noteriv.dsc.edu.vn
# 32-byte key for AES-256-GCM sync-credential encryption, e.g.: openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-hex-chars
REDIS_URL=redis://127.0.0.1:6379
COLLAB_PORT=4002
# Who may register: invite (default, needs an invite code), open, or closed. Anything else = closed.
REGISTRATION_MODE=invite
# Comma-separated emails allowed to manage invite codes (Menu > Mã mời). Empty = nobody.
ADMIN_EMAILS=
# Account emails: resend (needs RESEND_API_KEY), file (JSON files in EMAIL_OUTBOX_DIR, for dev/E2E), or empty = off.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=Noteriv <no-reply@noteriv.dsc.edu.vn>
# EMAIL_OUTBOX_DIR=.email-outbox
# Public origin of the web app, for links in emails (default: CORS_ORIGIN).
APP_ORIGIN=https://noteriv.dsc.edu.vn
# Cloudflare Turnstile on sign-up and forgot-password; both empty = off. Cloudflare's always-pass test keys:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
